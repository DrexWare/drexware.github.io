<!DOCTYPE html>  <head> <title>x</title> <style>:root{--bg-start:#0a0a0a;--bg-end:#1a1a1d;--card-bg:rgba(20, 20, 25, 0.7);--card-border:rgba(100, 150, 255, 0.15);--accent:#fafaff;--accent-hover:#a29bfe;--text-primary:#f8f9ff;--text-secondary:#b0b3c1;--glass-bg:rgba(30, 30, 46, 0.45)}@media (prefers-color-scheme:light){:root{--bg-start:#f8f9ff;--bg-end:#e2e8f0;--card-bg:rgba(255, 255, 255, 0.6);--card-border:rgba(100, 150, 255, 0.2);--text-primary:#1a1a2e;--text-secondary:#64748b;--glass-bg:rgba(255, 255, 255, 0.3)}}*{margin:0;padding:0;box-sizing:border-box}body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,sans-serif;background:linear-gradient(135deg,var(--bg-start) 0,var(--bg-end) 100%);background-attachment:fixed;min-height:100dvh;color:var(--text-primary);line-height:1.6}::-webkit-scrollbar{width:8px}::-webkit-scrollbar-track{background:0 0}::-webkit-scrollbar-thumb{background:rgba(150,150,200,.3);border-radius:4px}::-webkit-scrollbar-thumb:hover{background:rgba(150,150,200,.5)}.header{text-align:center;padding:2.5rem 1.5rem;background:var(--glass-bg);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--card-border);position:sticky;top:0;z-index:100}h1{font-size:50px;font-weight:800;background:linear-gradient(135deg,#000 0,#060535 25%,#0a3361 50%,#0c285c 75%,#060f64 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;background-size:200% 200%;animation:gradient-shift 3s ease infinite,float 6s ease-in-out infinite;letter-spacing:8px;user-select:none;filter:drop-shadow(0 10px 30px rgba(255, 255, 255, .2))}@keyframes gradient-shift{0%,100%{background-position:0 50%}50%{background-position:100% 50%}}.subtitle{color:var(--text-secondary);font-size:1.1rem;font-weight:400}.subtitle a{color:var(--accent);text-decoration:none;font-weight:500;transition:all .25s ease}.subtitle a:hover{color:var(--accent-hover);text-decoration:underline;text-underline-offset:3px}.search-container{max-width:640px;margin:2rem auto;position:relative}.search-box{width:100%;padding:1rem 1.5rem 1rem 3.5rem;font-size:1.1rem;background:var(--glass-bg);border:1.5px solid var(--card-border);border-radius:1.5rem;color:var(--text-primary);backdrop-filter:blur(10px);transition:all .3s cubic-bezier(.4, 0, .2, 1)}.search-box:focus{outline:0;border-color:var(--accent);box-shadow:0 0 0 4px rgba(108,92,231,.2);background:rgba(30,30,46,.8)}.search-box::placeholder{color:var(--text-secondary)}.search-icon{position:absolute;left:1.2rem;top:50%;transform:translateY(-50%);color:var(--accent);font-size:1.3rem;pointer-events:none}.main-content{max-width:1280px;margin:0 auto;padding:2rem 1.5rem}.letter-section{margin-bottom:4rem;opacity:0;transform:translateY(20px);animation:fadeInUp .6s ease forwards}.letter-section.hidden{display:none}.letter-header{font-size:2rem;font-weight:700;margin-bottom:1.5rem;color:var(--accent);position:relative;padding-left:1rem}.letter-header::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);width:4px;height:70%;background:var(--accent);border-radius:2px}.games-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.5rem}.game-card{background:var(--card-bg);border:1px solid var(--card-border);border-radius:1.5rem;padding:1.8rem 1.2rem;cursor:pointer;transition:all .35s cubic-bezier(.4, 0, .2, 1);backdrop-filter:blur(10px);position:relative;overflow:hidden}.game-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent,rgba(108,92,231,.15));opacity:0;transition:opacity .4s ease}.game-card:hover{transform:translateY(-8px) scale(1.02);border-color:var(--accent);box-shadow:0 20px 40px rgba(108,92,231,.25)}.game-card:hover::before{opacity:1}.game-title{font-size:1.15rem;font-weight:600;text-align:center;color:var(--text-primary);position:relative;z-index:1}.empty-section,.no-results{grid-column:1/-1;text-align:center;padding:4rem 2rem;color:var(--text-secondary);font-size:1.1rem;font-style:italic}.loading{width:24px;height:24px;border:2px solid rgba(108,92,231,.3);border-top-color:var(--accent);border-radius:50%;animation:spin .9s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@keyframes fadeInUp{to{opacity:1;transform:translateY(0)}}@media (max-width:640px){.games-grid{grid-template-columns:1fr}.search-box{padding-left:3.2rem}}@media (prefers-reduced-motion:reduce){*,::after,::before{animation-duration:0s!important;animation-iteration-count:1!important;transition-duration:0s!important}}</style> </head> <body> <div class="header"> <h1>moonlight</h1> <div class="subtitle"> Some games may not work. </div> <div class="search-container"> <input class="search-box" id="searchBox" placeholder="Search for games..."> <span class="search-icon">🔍</span> </div> </div> <div class="main-content"> <div id="sections-container">.</div> <div id="no-results" class="no-results" style="display:none"> No games found matching your search. </div> </div> <script>const files=["cl1","cl100skibidistillwaterthosewhoknow","cl10bullets","cl10minutestildawn","cl12minibattles","cl1on1soccer","cl1on1tennis","cl1v1doubleimprettysureitsexactlythesameidk","cl1v1lol","cl1v1lolifnoaboutblank","cl1v1lolnoaboutblank","cl1v1maybeidk","cl2048","cl2048cupcakes","cl2doom","cl2dshooting(1)","cl2Dshooting","cl3dash","cl3pandas","cl3pandasbrazil","cl3pandasfantasy","cl3pandasnight","cl3slices2","cl40escape","cl40exescape","cl4thandgoal","cl60secondsburgerrun","cl60secondssantarun","cl60secsantarun","cl8ballclassic","cl8ballpool","cl9007199254740992","cl99balls","clabandoned","clabandoned3","clabandoned32","clabsolutemadness","claceattorernefgsdg","clacecombat2","clacecombat3","clacegangstertaxi","clachievementunlocked","clachievmentunlocked","clachievmentunlocked2","clachievmentunlocked3","clachillies1fr","clachillies2","clADarkRoom","cladayintheoffice","clADOFAI","cladvancewars","cladvancewars2","cladventneon","clagariolite","clageofwa